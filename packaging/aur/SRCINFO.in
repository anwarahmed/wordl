pkgbase = wordl-bin
	pkgdesc = A Wordle-style word game for the terminal
	pkgver = @VERSION@
	pkgrel = 1
	url = https://github.com/anwarahmed/wordl
	arch = x86_64
	arch = aarch64
	license = MIT
	license = LicenseRef-SCOWL
	provides = wordl
	conflicts = wordl
	options = !strip
	options = !debug
	source = wordl-@VERSION@-LICENSE::https://raw.githubusercontent.com/anwarahmed/wordl/v@VERSION@/LICENSE
	source = wordl-@VERSION@-SCOWL-COPYRIGHT::https://raw.githubusercontent.com/anwarahmed/wordl/v@VERSION@/words/SCOWL-COPYRIGHT
	sha256sums = @SHA_LICENSE@
	sha256sums = @SHA_SCOWL@
	source_x86_64 = wordl-@VERSION@-x86_64::https://github.com/anwarahmed/wordl/releases/download/v@VERSION@/wordl-x86_64-unknown-linux-musl
	sha256sums_x86_64 = @SHA_X86_64@
	source_aarch64 = wordl-@VERSION@-aarch64::https://github.com/anwarahmed/wordl/releases/download/v@VERSION@/wordl-aarch64-unknown-linux-musl
	sha256sums_aarch64 = @SHA_AARCH64@

pkgname = wordl-bin
