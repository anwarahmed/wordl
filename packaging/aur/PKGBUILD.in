# Maintainer: Anwar Ahmed <anwar dot ahmed at gmail dot com>
#
# Generated by packaging/aur/render.sh in https://github.com/anwarahmed/wordl
# for each release; edit the template there, not this file.

pkgname=wordl-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="A Wordle-style word game for the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/anwarahmed/wordl"
license=('MIT' 'LicenseRef-SCOWL')
provides=('wordl')
conflicts=('wordl')
# The binaries are static and already stripped of debug info.
options=('!strip' '!debug')
source=("wordl-$pkgver-LICENSE::https://raw.githubusercontent.com/anwarahmed/wordl/v$pkgver/LICENSE"
        "wordl-$pkgver-SCOWL-COPYRIGHT::https://raw.githubusercontent.com/anwarahmed/wordl/v$pkgver/words/SCOWL-COPYRIGHT")
source_x86_64=("wordl-$pkgver-x86_64::$url/releases/download/v$pkgver/wordl-x86_64-unknown-linux-musl")
source_aarch64=("wordl-$pkgver-aarch64::$url/releases/download/v$pkgver/wordl-aarch64-unknown-linux-musl")
sha256sums=('@SHA_LICENSE@'
            '@SHA_SCOWL@')
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
    install -Dm755 "$srcdir/wordl-$pkgver-$CARCH" "$pkgdir/usr/bin/wordl"
    install -Dm644 "$srcdir/wordl-$pkgver-LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    # The word lists inside the binary are derived from SCOWL, which asks for its notice.
    install -Dm644 "$srcdir/wordl-$pkgver-SCOWL-COPYRIGHT" "$pkgdir/usr/share/licenses/$pkgname/SCOWL-COPYRIGHT"
    # pacman owns this copy: the marker tells the game never to update itself. It looks
    # for it at ../share/wordl/managed-by from the directory of its binary.
    install -d "$pkgdir/usr/share/wordl"
    echo "pacman; update the wordl-bin package" > "$pkgdir/usr/share/wordl/managed-by"
}
