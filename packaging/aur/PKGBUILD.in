# Maintainer: Anwar Ahmed <anwar dot ahmed at gmail dot com>
#
# Generated by packaging/aur/render.sh in https://github.com/anwarahmed/wordl
# for each release; edit the template there, not this file.

pkgname=wordl
pkgver=@VERSION@
pkgrel=1
pkgdesc="A Wordle-style word game for the terminal"
arch=('any')
url="https://github.com/anwarahmed/wordl"
license=('MIT' 'LicenseRef-SCOWL')
depends=('bash')
source=("$url/releases/download/v$pkgver/wordl-$pkgver.tar.gz")
sha256sums=('@SHA_ARCHIVE@')

package() {
    cd "wordl-$pkgver"
    # The script looks for its word lists in ../share/wordl from where it is installed.
    install -Dm755 wordl "$pkgdir/usr/bin/wordl"
    install -Dm644 -t "$pkgdir/usr/share/wordl" words/answers.txt words/allowed.txt
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 words/SCOWL-COPYRIGHT "$pkgdir/usr/share/licenses/$pkgname/SCOWL-COPYRIGHT"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
