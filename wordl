# --------------------------------------------------------------- colors ----

declare -A F B # SGR parameters for each palette name, as foreground / background

pal() { # name r g b
  if ((TRUECOLOR)); then
    F[$1]="38;2;$2;$3;$4" B[$1]="48;2;$2;$3;$4"
  else
    # Nearest of the 6x6x6 color cube and the 24-step gray ramp.
    local r=$2 g=$3 b=$4 n v i gray gi gv dc=0 dg=0
    local -a ci=() cv=()
    for v in "$r" "$g" "$b"; do
      if ((v < 48)); then i=0; elif ((v < 115)); then i=1; else i=$(((v - 35) / 40)); fi
      ci+=("$i") cv+=($((i ? 55 + 40 * i : 0)))
    done
    gray=$(((r + g + b) / 3))
    if ((gray < 8)); then gi=0; elif ((gray > 238)); then gi=23; else gi=$(((gray - 3) / 10)); fi
    gv=$((8 + 10 * gi)) i=0
    for v in "$r" "$g" "$b"; do
      dc=$((dc + (v - cv[i]) * (v - cv[i]))) dg=$((dg + (v - gv) * (v - gv)))
      ((i++))
    done
    if ((dg < dc)); then n=$((232 + gi)); else n=$((16 + 36 * ci[0] + 6 * ci[1] + ci[2])); fi
    F[$1]="38;5;$n" B[$1]="48;5;$n"
  fi
}

