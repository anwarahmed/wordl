#!/usr/bin/env bash
#
# wordl - a Wordle-style word game for the terminal, written in bash.
#
# The whole screen is the game: the board, the on-screen keyboard and the
# title are sized to the terminal and redrawn when it is resized. Big tiles
# are painted with half-block characters, so a letter is a small bitmap that
# can be scaled, not a single terminal cell.

VERSION="0.1.0"

