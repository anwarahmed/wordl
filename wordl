# -------------------------------------------------------------- drawing ----

OUT=''
flush() { printf '%s' "$OUT"; OUT=''; }

rep() { # string count -> REPLY
  printf -v REPLY '%*s' "$2" ''
  REPLY=${REPLY// /$1}
}

# Pick the bitmap font (5 or 7 pixels tall) and whole-number scale that fill
# a block of $1 rows best. A block has 2*rows-4 pixel rows for its glyph.
font_for() {
  local a=$((2 * $1 - 4)) f s best=0
  local lim=$((a - a / 8))
  FONT_F=5 FONT_S=1
  for f in 7 5; do
    s=$((lim / f))
    if ((s >= 1 && f * s > best)); then best=$((f * s)) FONT_F=$f FONT_S=$s; fi
  done
}

# Render a label into half-block rows for a block w columns by t rows and
# cache it in GC. Rows are colorless: only spaces and block characters.
glyph() { # label w t
  local label=$1 w=$2 t=$3 key="$2.$3.$1"
  [[ -n ${GC[$key]:-} ]] && return
  GC[$key]=1
  local a=$((2 * t - 4)) s f bw i j line seg zero top bot row
  local -a bm px=()
  if [[ -n ${ICON[$label]:-} ]]; then
    read -ra bm <<<"${ICON[$label]}"
    f=5 bw=7 s=$(((a - a / 8) / 5))
    (((w - 2) / 7 < s)) && s=$(((w - 2) / 7))
    ((s < 1)) && s=1
  else
    font_for "$t"
    f=$FONT_F s=$FONT_S bw=5
    if ((f == 7)); then read -ra bm <<<"${FONT7[$label]}"; else read -ra bm <<<"${FONT5[$label]}"; fi
  fi
  local gw=$((bw * s)) gh=$((f * s))
  local xo=$(((w - gw) / 2)) yo=$(((a - gh) / 2))
  rep 0 "$w"; zero=$REPLY
  for ((i = 0; i < yo; i++)); do px+=("$zero"); done
  for line in "${bm[@]}"; do
    seg=''
    for ((j = 0; j < bw; j++)); do
      if [[ ${line:j:1} == '#' ]]; then rep 1 "$s"; else rep 0 "$s"; fi
      seg+=$REPLY
    done
    seg="${zero:0:xo}${seg}${zero:0:w-xo-gw}"
    for ((j = 0; j < s; j++)); do px+=("$seg"); done
  done
  while ((${#px[@]} < a)); do px+=("$zero"); done
  for ((i = 1; i <= t - 2; i++)); do
    top=${px[2 * (i - 1)]} bot=${px[2 * (i - 1) + 1]} row=''
    for ((j = 0; j < w; j++)); do row+=${HB[${top:j:1}${bot:j:1}]}; done
    GC[$key.$i]=$row
  done
}

# Draw one tile or key. t is the height in rows:
#   1    one row of text on a colored background
#   3    half-block edges around one row of text
#   5+   half-block edges around a bitmap glyph
# mode "fill" paints the block in color bg; "outline" draws a frame in color
# bg on the screen background. inset squashes the block vertically (used by
# the flip animation).
block() { # x y w t mode bg fg label [inset]
  local x=$1 y=$2 w=$3 t=$4 mode=$5 bg=$6 fg=$7 label=$8 k=${9:-0}
  local i row l r
  if ((t < 3)); then
    l=$(((w - ${#label}) / 2)) r=$((w - ${#label} - (w - ${#label}) / 2))
    printf -v row '%*s%s%*s' "$l" '' "$label" "$r" ''
    OUT+="${CSI}${y};${x}H${CSI}0;1;${F[$fg]};${B[$bg]}m${row}"
    return
  fi
  local top=$k bot=$((t - 1 - k)) edge="${CSI}0;${F[$bg]};${B[bg]}m"
  if ((k > 0)); then
    printf -v row '%*s' "$w" ''
    for ((i = 0; i < t; i++)); do
      ((i < top || i > bot)) && OUT+="${CSI}$((y + i));${x}H${CSI}0;${B[bg]}m${row}"
    done
    ((bot < top)) && return
    if ((bot == top)); then
      rep '━' "$w"
      OUT+="${CSI}$((y + top));${x}H${edge}${REPLY}"
      return
    fi
  fi
  rep '▄' "$w"; OUT+="${CSI}$((y + top));${x}H${edge}${REPLY}"
  rep '▀' "$w"; OUT+="${CSI}$((y + bot));${x}H${REPLY}"
  ((t > 3)) && [[ -n $label ]] && glyph "$label" "$w" "$t"
  for ((i = top + 1; i < bot; i++)); do
    if [[ -z $label ]]; then
      printf -v row '%*s' "$w" ''
    elif ((t == 3)); then
      l=$(((w - ${#label}) / 2)) r=$((w - ${#label} - (w - ${#label}) / 2))
      printf -v row '%*s%s%*s' "$l" '' "$label" "$r" ''
    else
      row=${GC[$w.$t.$label.$i]}
    fi
    OUT+="${CSI}$((y + i));${x}H"
    if [[ $mode == fill ]]; then
      OUT+="${CSI}0;1;${F[$fg]};${B[$bg]}m${row}"
    else
      OUT+="${edge}█${CSI}1;${F[$fg]}m${row:1:w-2}${CSI}22;${F[$bg]}m█"
    fi
  done
}

put_center() { # y x0 width sgr text -- also clears the rest of the region
  local y=$1 x0=$2 w=$3 sgr=$4 s=$5 l r
  ((${#s} > w)) && s=${s:0:w}
  l=$(((w - ${#s}) / 2)) r=$((w - ${#s} - (w - ${#s}) / 2))
  printf -v l '%*s' "$l" ''
  printf -v r '%*s' "$r" ''
  OUT+="${CSI}${y};${x0}H${CSI}0;${B[bg]}m${l}${CSI}${sgr}m${s}${CSI}0;${B[bg]}m${r}"
}

# --------------------------------------------------------------- layout ----

# Geometry of a tile/key grid at a size level -> D_T (block rows), D_W
# (block columns), D_PX / D_PY (distance between neighbours).
dims() {
  case $1 in
    1) D_T=1 D_W=3 D_PX=4 D_PY=1 ;;
    2) D_T=1 D_W=5 D_PX=6 D_PY=2 ;;
    3) D_T=3 D_W=5 D_PX=7 D_PY=3 ;;
    *)
      font_for "$1"
      D_T=$1 D_W=$((2 * $1 - 2 + FONT_S % 2)) D_PX=$((2 * $1 + FONT_S % 2)) D_PY=$1
      ;;
  esac
}

kb_range() { # board level -> KMIN KMAX
  local l=$1
  KMIN=1
  ((l >= 5)) && KMIN=2
  ((l >= 8)) && KMIN=3
  KMAX=$((l * 4 / 5))
  ((KMAX == 4)) && KMAX=3
  ((KMAX < KMIN)) && KMAX=$KMIN
}

# Find the biggest board that fits, with the keyboard under it ("stacked")
# or beside it ("side"). Sets FIT_L FIT_K FIT_H (0 when nothing fits).
fit() { # stacked|side
  local kind=$1 l k hv bw bh kw kh tw hh
  FIT_L=0 FIT_K=0 FIT_H=0
  for l in "${LEVELS[@]}"; do
    dims "$l"
    bw=$((4 * D_PX + D_W)) bh=$((5 * D_PY + D_T))
    ((bw > COLS)) && continue
    [[ $kind == side ]] && ((bh > ROWS - 1)) && continue
    kb_range "$l"
    for ((k = KMAX; k >= KMIN; k--)); do
      ((k == 4)) && continue
      dims "$k"
      kw=$((9 * D_PX + D_W)) kh=$((2 * D_PY + D_T))
      for hv in 5 3 1; do
        ((hv > 1 && hv > l)) && continue
        dims "$hv"
        tw=$((4 * D_PX + D_W)) hh=$((hv == 1 ? 1 : hv + 1))
        if [[ $kind == stacked ]]; then
          ((kw > COLS || tw > COLS)) && continue
          ((hh + bh + 1 + kh + 1 > ROWS)) && continue
        else
          ((bw + 4 + kw > COLS || bw + 4 + tw > COLS)) && continue
          ((hh + 1 + kh > ROWS - 1)) && continue
        fi
        FIT_L=$l FIT_K=$k FIT_H=$hv
        return
      done
    done
  done
}

layout() {
  local sl sk sh spare g1=0 g2=0 g3=0 y bw bh kw kh tw hh
  fit stacked; sl=$FIT_L sk=$FIT_K sh=$FIT_H
  fit side
  LAYOUT=side
  if ((sl > FIT_L || (sl == FIT_L && sk >= FIT_K))); then
    LAYOUT=stacked FIT_L=$sl FIT_K=$sk FIT_H=$sh
  fi
  if ((FIT_L == 0)); then LAYOUT=small; return; fi

  dims "$FIT_L"; BT=$D_T BW=$D_W BPX=$D_PX BPY=$D_PY
  bw=$((4 * BPX + BW)) bh=$((5 * BPY + BT))
  dims "$FIT_K"; KT=$D_T KW=$D_W KPX=$D_PX KPY=$D_PY
  kw=$((9 * KPX + KW)) kh=$((2 * KPY + KT))
  KSA=$(((3 * KW + KPX - KW + 1) / 2)) KSB=$(((3 * KW + KPX - KW) / 2))
  HV=$FIT_H
  dims "$HV"; HT=$D_T HW=$D_W HPX=$D_PX
  tw=$((4 * HPX + HW)) hh=$((HV == 1 ? 1 : HV + 1))
  FY=$ROWS

  if [[ $LAYOUT == stacked ]]; then
    spare=$((ROWS - (hh + bh + 1 + kh + 1)))
    ((spare > 0)) && g1=1 && ((spare--))
    ((spare > 0)) && g3=1 && ((spare--))
    ((spare > 0)) && g2=1 && ((spare--))
    y=$((1 + spare / 2))
    RX=1 RW=$COLS
    HY=$y; y=$((y + hh + g1))
    BY=$y; y=$((y + bh + g2))
    MSGY=$y; y=$((y + 1 + g3))
    KY=$y
    BX=$(((COLS - bw) / 2 + 1))
  else
    local pw=$((kw > tw ? kw : tw)) gap left
    gap=$(((COLS - bw - pw) / 3))
    ((gap < 4)) && gap=4
    ((gap > 16)) && gap=16
    left=$(((COLS - bw - gap - pw) / 2 + 1))
    BX=$left BY=$((1 + (ROWS - 1 - bh) / 2))
    RX=$((left + bw + gap)) RW=$pw
    spare=$((ROWS - 1 - (hh + 1 + kh)))
    ((spare > 0)) && g1=1 && ((spare--))
    ((spare > 0)) && g3=1 && ((spare--))
    ((spare > 5)) && g1=2 && g3=2 && ((spare -= 2))
    HY=$((1 + spare / 2))
    MSGY=$((HY + hh + g1))
    KY=$((MSGY + 1 + g3))
  fi
  IY=0
  ((HV > 1)) && IY=$((HY + HV))
  HX=$((RX + (RW - tw) / 2))
  KX=$((RX + (RW - kw) / 2))
}

get_size() {
  local size
  size=$(stty size 2>/dev/null </dev/tty)
  ROWS=${size% *} COLS=${size#* }
  [[ $ROWS =~ ^[0-9]+$ && $COLS =~ ^[0-9]+$ ]] || { ROWS=$(tput lines) COLS=$(tput cols); }
  ((ROWS > 0 && COLS > 0)) || { ROWS=24 COLS=80; }
}

# ------------------------------------------------------------ rendering ----

info_text() {
  local s
  if [[ $MODE == daily ]]; then s="Daily #$((DAY - DAILY_BASE))"; else s="Practice"; fi
  ((GAME_HARD)) && s+=" · ${DIFFS[GAME_HARD]}"
  ((${ST[${MODE}_streak]:-0} > 0)) && s+=" · Streak ${ST[${MODE}_streak]}"
  REPLY=$s
}

draw_title() {
  local letters=WORDL colors=(g y x g y) i x=$HX info
  info_text; info=$REPLY
  if ((IY)); then
    put_center "$IY" "$RX" "$RW" "${F[dim]}" "$info"
  else
    put_center "$HY" "$RX" "$RW" 0 ''
    if ((19 + 2 + ${#info} <= RW)); then
      x=$((RX + (RW - 21 - ${#info}) / 2))
      OUT+="${CSI}${HY};$((x + 21))H${CSI}0;${F[dim]};${B[bg]}m${info}"
    fi
  fi
  for i in 0 1 2 3 4; do
    block $((x + i * HPX)) "$HY" "$HW" "$HT" fill "${colors[i]}" "${colors[i]}fg" "${letters:i:1}"
  done
}

REVEAL_ROW=-1 REVEAL_COL=0 FLASH_ROW=-1 FLASH_COL=-1 ROW_DX=0

draw_tile() { # row col [inset]
  local r=$1 c=$2 k=${3:-0} ch mark
  local x=$((BX + c * BPX)) y=$((BY + r * BPY)) n=${#GUESSES[@]}
  ((r == n || r == REVEAL_ROW)) && x=$((x + ROW_DX))
  if ((r < n)) && ! ((r == REVEAL_ROW && c >= REVEAL_COL)); then
    ch=${GUESSES[r]:c:1} mark=${MARKS[r]:c:1}
    if ((r == FLASH_ROW && c == FLASH_COL)); then
      block "$x" "$y" "$BW" "$BT" fill win gfg "$ch" "$k"
    else
      block "$x" "$y" "$BW" "$BT" fill "$mark" "${mark}fg" "$ch" "$k"
    fi
    return
  fi
  if ((r < n)); then ch=${GUESSES[r]:c:1}; elif ((r == n)); then ch=${CUR:c:1}; else ch=''; fi
  if ((BT == 1)); then
    block "$x" "$y" "$BW" 1 fill empty fg "$ch"
  elif [[ -n $ch ]]; then
    block "$x" "$y" "$BW" "$BT" outline typed fg "$ch" "$k"
  else
    block "$x" "$y" "$BW" "$BT" outline empty fg '' "$k"
  fi
}

draw_row() { local c; for c in 0 1 2 3 4; do draw_tile "$1" "$c"; done; }
draw_board() { local r; for r in 0 1 2 3 4 5; do draw_row "$r"; done; }

draw_key() { # x y w id register
  local x=$1 y=$2 w=$3 id=$4 bg=key fg=keyfg label=$4
  case ${KEYSTATE[$id]:-} in
    g) bg=g fg=gfg ;;
    y) bg=y fg=yfg ;;
    x) bg=keyx fg=keyxfg ;;
  esac
  if ((KT < 5)); then
    case $id in
      ENTER) ((w >= 7)) && label=ENTER || label='↵' ;;
      BACK) label='⌫' ;;
    esac
  fi
  block "$x" "$y" "$w" "$KT" fill "$bg" "$fg" "$label"
  (($5)) && HITS+=("$x $y $((x + w - 1)) $((y + KPY - 1)) key:$id")
}

draw_keyboard() { # [register hit boxes]
  local reg=${1:-0} r i x y row gap=$((KPX - KW))
  for r in 0 1 2; do
    row=${KB_ROWS[r]} x=$KX y=$((KY + r * KPY))
    ((r == 1)) && x=$((KX + KPX / 2))
    if ((r == 2)); then
      draw_key "$x" "$y" "$KSA" BACK "$reg"
      x=$((x + KSA + gap))
    fi
    for ((i = 0; i < ${#row}; i++)); do
      draw_key "$x" "$y" "$KW" "${row:i:1}" "$reg"
      x=$((x + KPX))
    done
    ((r == 2)) && draw_key "$x" "$y" "$KSB" ENTER "$reg"
  done
}

MSG='' MSG_KIND='' MSG_UNTIL=0

draw_msg() {
  if [[ -z $MSG ]]; then
    put_center "$MSGY" "$RX" "$RW" 0 ''
    return
  fi
  case $MSG_KIND in
    win) put_center "$MSGY" "$RX" "$RW" "1;${F[gfg]};${B[g]}" " $MSG " ;;
    plain) put_center "$MSGY" "$RX" "$RW" "1;${F[fg]};${B[bg]}" "$MSG" ;;
    *) put_center "$MSGY" "$RX" "$RW" "1;${F[toastfg]};${B[toast]}" " $MSG " ;;
  esac
}

toast() { # text kind seconds (0 = stays)
  MSG=$1 MSG_KIND=$2
  if (($3)); then MSG_UNTIL=$((SECONDS + $3)); else MSG_UNTIL=0; fi
  draw_msg
  flush
}

clear_toast() {
  [[ -n $MSG ]] && ((MSG_UNTIL)) || return
  MSG='' MSG_UNTIL=0
  draw_msg
}

draw_footer() {
  local items=("?|Help|help" "^N|New|new" "^D|Daily|daily" "^S|Stats|stats"
    "^T|Theme|theme" "^X|${DIFFS[HARD]%% *}|hard" "^Q|Quit|quit")
  local it key label act sep total labels=1 x w style
  for sep in 3 2 1 0; do
    total=0
    for it in "${items[@]}"; do
      IFS='|' read -r key label act <<<"$it"
      total=$((total + ${#key} + 1 + ${#label} + sep))
    done
    total=$((total - sep))
    ((sep > 0 && total <= COLS - 2)) && break
  done
  if ((sep == 0)); then labels=0 sep=2 total=$((7 * 2 - 1 + 6 * 2)); fi
  put_center "$FY" 1 "$COLS" 0 ''
  x=$(((COLS - total) / 2 + 1))
  for it in "${items[@]}"; do
    IFS='|' read -r key label act <<<"$it"
    style=${F[dim]}
    [[ $act == hard ]] && ((HARD == 1)) && style="1;${F[g]}"
    [[ $act == hard ]] && ((HARD == 2)) && style="1;${F[y]}"
    OUT+="${CSI}${FY};${x}H${CSI}0;1;${F[accent]};${B[bg]}m${key}"
    w=${#key}
    if ((labels)); then
      OUT+="${CSI}0;${style};${B[bg]}m ${label}"
      w=$((w + 1 + ${#label}))
    fi
    HITS+=("$((x - 1)) $FY $((x + w)) $FY cmd:$act")
    x=$((x + w + sep))
  done
}

draw_bg() {
  local y line
  printf -v line '%*s' "$COLS" ''
  for ((y = 1; y <= ROWS; y++)); do OUT+="${CSI}${y};1H${CSI}0;${B[bg]}m${line}"; done
}

render() {
  OUT="${CSI}?2026h"
  HITS=() MHITS=()
  draw_bg
  if [[ $LAYOUT == small ]]; then
    put_center $(((ROWS + 1) / 2)) 1 "$COLS" "1;${F[fg]};${B[bg]}" "wordl needs 39x12"
    ((ROWS > 2)) && put_center $(((ROWS + 1) / 2 + 1)) 1 "$COLS" "${F[dim]};${B[bg]}" "this is ${COLS}x${ROWS}"
  else
    draw_title
    draw_board
    draw_msg
    draw_keyboard 1
    draw_footer
    [[ -n $MODAL ]] && draw_modal
  fi
  OUT+="${CSI}?2026l"
  flush
}

# --------------------------------------------------------------- modals ----

MODAL=''
declare -a ML_S ML_N ML_A MBTN

ml() { ML_A+=("$1") ML_N+=("$2") ML_S+=("$3"); } # align(c|l) visible-length string
mlt() { ml "$1" "${#3}" "${CSI}${2}m${3}"; }     # align sgr plain-text

build_help() {
  local p="${CSI}0;${F[fg]};${B[panel]}m" k="1;${F[accent]}" c k1 d1 k2 d2 pad
  mlt c "1;${F[accent]}" "HOW TO PLAY"
  ml c 0 ''
  mlt l "${F[fg]}" "Guess the hidden word in 6 tries."
  mlt l "${F[fg]}" "Each guess must be a real 5-letter"
  mlt l "${F[fg]}" "word. The tiles then show:"
  ml c 0 ''
  for c in "g|right letter, right spot" "y|right letter, wrong spot" "x|letter is not in the word"; do
    ml l $((5 + ${#c} - 2)) "${CSI}1;${F[${c%%|*}fg]};${B[${c%%|*}]}m A ${p}  ${c#*|}"
  done
  ml c 0 ''
  for c in "A-Z|type|Enter|submit" "Bksp|delete|?|this help" "^N|new game|^D|daily puzzle" \
    "^S|statistics|^T|change theme" "^X|difficulty|^Q|quit"; do
    IFS='|' read -r k1 d1 k2 d2 <<<"$c"
    printf -v pad '%*s' $((17 - ${#k1} - ${#d1})) ''
    ml l $((18 + ${#k2} + 1 + ${#d2})) "${CSI}${k}m${k1}${p} ${d1}${pad}${CSI}${k}m${k2}${p} ${d2}"
  done
  ml c 0 ''
  for c in "Normal|any real word" "Hard|reuse green and yellow" "Ultra|obey every clue"; do
    k1=${c%%|*} d1=${c#*|}
    printf -v pad '%*s' $((8 - ${#k1})) ''
    ml l $((8 + ${#d1})) "${CSI}1;${F[fg]}m${k1}${p}${pad}${CSI}${F[dim]}m${d1}"
  done
  MBTN=("Esc Close|close")
}

build_stats() {
  local p="${CSI}0;${F[fg]};${B[panel]}m" m=$MODE i n max=1 len bar color
  local played=${ST[${m}_played]:-0} wins=${ST[${m}_wins]:-0} pct=0
  ((played)) && pct=$((wins * 100 / played))
  mlt c "1;${F[accent]}" "STATISTICS · ${m^^}"
  ml c 0 ''
  if [[ $STATE == won ]]; then
    mlt c "1;${F[g]}" "Solved in ${#GUESSES[@]}/6"
    ml c 0 ''
  elif [[ $STATE == lost ]]; then
    ml c $((13 + 5)) "${CSI}${F[fg]}mThe word was ${CSI}1;${F[y]}m${ANSWER}${p}"
    ml c 0 ''
  fi
  printf -v bar '%6s  %6s  %6s  %6s' Played 'Win %' Streak Best
  mlt c "${F[dim]}" "$bar"
  printf -v bar '%6s  %6s  %6s  %6s' "$played" "$pct" "${ST[${m}_streak]:-0}" "${ST[${m}_best]:-0}"
  mlt c "1;${F[fg]}" "$bar"
  ml c 0 ''
  mlt l "${F[dim]}" "GUESS DISTRIBUTION"
  for i in 1 2 3 4 5 6; do
    n=${ST[${m}_d$i]:-0}
    ((n > max)) && max=$n
  done
  for i in 1 2 3 4 5 6; do
    n=${ST[${m}_d$i]:-0}
    len=$((n * 26 / max))
    ((len < ${#n} + 1)) && len=$((${#n} + 1))
    printf -v bar '%*s ' "$len" "$n"
    color="${F[keyfg]};${B[key]}"
    [[ $STATE == won ]] && ((i == ${#GUESSES[@]})) && color="${F[gfg]};${B[g]}"
    ml l $((2 + len + 1)) "${CSI}${F[dim]}m${i} ${CSI}1;${color}m${bar}${p}"
  done
  if [[ $STATE == playing ]]; then
    MBTN=("Esc Close|close")
  else
    MBTN=("Enter New|new" "C Copy|copy" "Esc Close|close")
  fi
}

draw_modal() {
  ML_S=() ML_N=() ML_A=() MBTN=() MHITS=()
  case $MODAL in
    help) build_help ;;
    stats) build_stats ;;
  esac
  local p="${CSI}0;${F[fg]};${B[panel]}m" bd="${CSI}0;${F[panelb]};${B[panel]}m"
  local inner=35 n=${#ML_S[@]} i w h x0 y0 l r lp rp bt bw=0 label x
  for ((i = 0; i < n; i++)); do ((ML_N[i] > inner)) && inner=${ML_N[i]}; done
  for bt in "${MBTN[@]}"; do label=${bt%%|*}; bw=$((bw + ${#label} + 4)); done
  bw=$((bw - 2))
  w=$((inner + 4)) h=$((n + 4))
  if ((h > ROWS)); then n=$((ROWS - 4)) h=$ROWS; fi
  ((n < 0)) && n=0
  x0=$(((COLS - w) / 2 + 1)) y0=$(((ROWS - h) / 2 + 1))
  ((x0 < 1)) && x0=1
  rep '─' $((w - 2))
  OUT+="${CSI}${y0};${x0}H${bd}╭${REPLY}╮"
  OUT+="${CSI}$((y0 + h - 1));${x0}H${bd}╰${REPLY}╯"
  for ((i = 0; i < n + 2; i++)); do
    OUT+="${CSI}$((y0 + 1 + i));${x0}H${bd}│${p} "
    if ((i < n)); then
      l=0
      [[ ${ML_A[i]} == c ]] && l=$(((inner - ML_N[i]) / 2))
      r=$((inner - ML_N[i] - l))
      printf -v lp '%*s' "$l" ''
      printf -v rp '%*s' "$r" ''
      OUT+="${lp}${ML_S[i]}${p}${rp}"
    elif ((i == n)); then
      printf -v lp '%*s' "$inner" ''
      OUT+=$lp
    else
      l=$(((inner - bw) / 2)) r=$((inner - bw - (inner - bw) / 2))
      printf -v lp '%*s' "$l" ''
      printf -v rp '%*s' "$r" ''
      OUT+=$lp
      x=$((x0 + 2 + l))
      for bt in "${MBTN[@]}"; do
        label=${bt%%|*}
        OUT+="${CSI}1;${F[btnfg]};${B[btn]}m ${label} ${p}"
        MHITS+=("$x $((y0 + 1 + i)) $((x + ${#label} + 1)) $((y0 + 1 + i)) cmd:${bt#*|}")
        x=$((x + ${#label} + 4))
        [[ $bt != "${MBTN[-1]}" ]] && OUT+="  "
      done
      OUT+=$rp
    fi
    OUT+=" ${bd}│"
  done
}

# ----------------------------------------------------------------- game ----

declare -A ST KEYSTATE
declare -a GUESSES MARKS ANSWERS
CUR='' ANSWER='' STATE=playing MODE=daily DAY=0 HARD=0 GAME_HARD=0 PENDING=''

load_words() {
  local d
  DATA_DIR=''
  for d in "${WORDL_DATA_DIR:-}" "$SELF_DIR/words" "$SELF_DIR/../share/wordl"; do
    if [[ -n $d && -r $d/answers.txt && -r $d/allowed.txt ]]; then DATA_DIR=$d; break; fi
  done
  if [[ -z $DATA_DIR ]]; then
    echo "wordl: cannot find the word lists (answers.txt, allowed.txt)." >&2
    echo "Set WORDL_DATA_DIR to the folder that holds them." >&2
    exit 1
  fi
  mapfile -t ANSWERS <"$DATA_DIR/answers.txt"
  ALLOWED=$'\n'$(<"$DATA_DIR/allowed.txt")$'\n'
}

is_word() { [[ $ALLOWED == *$'\n'"${1,,}"$'\n'* ]]; }

today() { # -> REPLY: local days since 1970-01-01
  local now z s
  printf -v now '%(%s)T' -1
  printf -v z '%(%z)T' -1
  s=$((10#${z:1:2} * 3600 + 10#${z:3:2} * 60))
  [[ $z == -* ]] && s=$((-s))
  REPLY=$(((now + s) / 86400))
}

load_kv() { # file assoc-name -- reads key=value lines, ignoring anything odd
  local k v
  local -n dest=$2
  [[ -r $1 ]] || return 1
  while IFS='=' read -r k v; do
    # shellcheck disable=SC2034 # dest is a nameref: this writes the caller's array
    [[ $k =~ ^[a-z0-9_]+$ && $v =~ ^[A-Za-z0-9,]*$ ]] && dest["$k"]=$v
  done <"$1"
}

save_stats() {
  local k
  ST[theme]=$THEME ST[hard]=$HARD
  mkdir -p "$STATE_DIR" 2>/dev/null || return
  for k in "${!ST[@]}"; do printf '%s=%s\n' "$k" "${ST[$k]}"; done | sort >"$STATE_DIR/stats"
}

save_game() { # only the daily puzzle is resumed, so only it is saved
  local IFS=,
  [[ $MODE == daily ]] || return
  mkdir -p "$STATE_DIR" 2>/dev/null || return
  printf 'day=%s\nanswer=%s\nhard=%s\nguesses=%s\n' \
    "$DAY" "$ANSWER" "$GAME_HARD" "${GUESSES[*]}" >"$STATE_DIR/$MODE"
}

evaluate() { # guess answer -> REPLY, one of g/y/x per letter
  local g=$1 a=$2 i ch rest='' out=''
  local -a m=(x x x x x)
  for i in 0 1 2 3 4; do
    if [[ ${g:i:1} == "${a:i:1}" ]]; then m[i]=g; else rest+=${a:i:1}; fi
  done
  for i in 0 1 2 3 4; do
    ch=${g:i:1}
    if [[ ${m[i]} != g && $rest == *"$ch"* ]]; then
      m[i]=y
      rest=${rest/$ch/}
    fi
    out+=${m[i]}
  done
  REPLY=$out
}

add_guess() { # guess -- records it and updates the keyboard colors
  local g=$1 i ch m
  evaluate "$g" "$ANSWER"
  GUESSES+=("$g") MARKS+=("$REPLY")
  for i in 0 1 2 3 4; do
    ch=${g:i:1} m=${REPLY:i:1}
    case ${KEYSTATE[$ch]:-}$m in
      g* | yy | yx) ;;
      *) KEYSTATE[$ch]=$m ;;
    esac
  done
  if [[ $g == "$ANSWER" ]]; then
    STATE=won
  elif ((${#GUESSES[@]} >= 6)); then
    STATE=lost
  fi
}

end_message() {
  local praise=(Genius Magnificent Impressive Splendid Great Phew)
  MSG_UNTIL=0
  if [[ $STATE == won ]]; then
    MSG="${praise[${#GUESSES[@]} - 1]}! Solved in ${#GUESSES[@]}/6" MSG_KIND=win
  elif [[ $STATE == lost ]]; then
    MSG="The word was $ANSWER" MSG_KIND=error
  else
    MSG='' MSG_KIND=''
  fi
}

# Start a game. Practice is always a new random word; the daily puzzle picks
# up where it was left, since there is only one word a day.
new_game() { # daily|practice
  local -A saved=()
  local g n=${#ANSWERS[@]}
  MODE=$1
  GUESSES=() MARKS=() KEYSTATE=() CUR='' STATE=playing PENDING='' GAME_HARD=$HARD
  today; DAY=$REPLY
  if [[ $MODE == daily ]]; then
    ANSWER=${ANSWERS[(DAY * 7919 + 104729) % n]^^}
    load_kv "$STATE_DIR/daily" saved
    [[ ${saved[day]:-} == "$DAY" ]] || saved=()
  else
    ANSWER=${ANSWERS[(RANDOM * 32768 + RANDOM) % n]^^}
    [[ -n ${WORDL_DEBUG_ANSWER:-} ]] && ANSWER=${WORDL_DEBUG_ANSWER^^}
  fi
  if [[ ${saved[answer]:-} =~ ^[A-Z]{5}$ ]]; then
    ANSWER=${saved[answer]}
    GAME_HARD=0
    [[ ${saved[hard]:-} == [12] ]] && GAME_HARD=${saved[hard]}
    for g in ${saved[guesses]//,/ }; do
      [[ $g =~ ^[A-Z]{5}$ && $STATE == playing ]] && add_guess "$g"
    done
  fi
  end_message
}

record_result() {
  local m=$MODE n=${#GUESSES[@]}
  ST[${m}_played]=$((${ST[${m}_played]:-0} + 1))
  if [[ $STATE == won ]]; then
    ST[${m}_wins]=$((${ST[${m}_wins]:-0} + 1))
    ST[${m}_d$n]=$((${ST[${m}_d$n]:-0} + 1))
    if [[ $m == daily && ${ST[daily_lastwin]:-0} != $((DAY - 1)) ]]; then
      ST[daily_streak]=1
    else
      ST[${m}_streak]=$((${ST[${m}_streak]:-0} + 1))
    fi
    [[ $m == daily ]] && ST[daily_lastwin]=$DAY
    ((${ST[${m}_streak]} > ${ST[${m}_best]:-0})) && ST[${m}_best]=${ST[${m}_streak]}
  else
    ST[${m}_streak]=0
  fi
  save_stats
}

# Check a guess against the clues so far, for the Hard and Ultra Hard
# difficulties. Fails with REPLY set to the reason.
#   Hard        green letters stay where they are, yellow letters are reused
#   Ultra Hard  also: a yellow letter must move to another spot, and a gray
#               letter may not be played again (beyond the copies the same
#               guess showed as green or yellow)
hard_check() { # guess
  local g=$1 r i j ch prev marks known rest ord=(1st 2nd 3rd 4th 5th)
  for ((r = 0; r < ${#GUESSES[@]}; r++)); do
    prev=${GUESSES[r]} marks=${MARKS[r]}
    for i in 0 1 2 3 4; do
      ch=${prev:i:1}
      case ${marks:i:1} in
        g) [[ ${g:i:1} == "$ch" ]] || { REPLY="${ord[i]} letter must be $ch"; return 1; } ;;
        y) [[ $g == *"$ch"* ]] || { REPLY="Guess must contain $ch"; return 1; } ;;
      esac
    done
    ((GAME_HARD < 2)) && continue
    for i in 0 1 2 3 4; do
      ch=${prev:i:1}
      [[ ${marks:i:1} == g ]] && continue
      if [[ ${marks:i:1} == y ]]; then
        [[ ${g:i:1} != "$ch" ]] || { REPLY="${ord[i]} letter can't be $ch"; return 1; }
        continue
      fi
      known=0
      for j in 0 1 2 3 4; do
        [[ ${prev:j:1} == "$ch" && ${marks:j:1} != x ]] && ((known++))
      done
      rest=${g//[!$ch]/}
      if ((${#rest} > known)); then
        if ((known == 0)); then REPLY="$ch is not in the word"; else REPLY="Only $known $ch in the word"; fi
        return 1
      fi
      [[ ${g:i:1} != "$ch" ]] || { REPLY="${ord[i]} letter can't be $ch"; return 1; }
    done
  done
}

# ------------------------------------------------------------ animation ----

nap() { # seconds -- sleeps without touching stdin, so typed keys queue up
  if [[ -n $NAP_FD ]]; then read -rt "$1" -u "$NAP_FD" _ || :; else sleep "$1"; fi
}

shake() {
  local r=${#GUESSES[@]} dx amp=2 w=$((4 * BPX + BW)) i line
  ((ANIM)) || return
  ((BX - 1 < amp)) && amp=$((BX - 1))
  ((BX + w - 1 + amp > COLS)) && amp=$((COLS - BX - w + 1))
  ((amp < 1)) && return
  printf -v line '%*s' $((w + 2 * amp)) ''
  for dx in -$amp $amp -$amp $amp -1 1 0; do
    for ((i = 0; i < BT; i++)); do
      OUT+="${CSI}$((BY + r * BPY + i));$((BX - amp))H${CSI}0;${B[bg]}m${line}"
    done
    ROW_DX=$dx
    draw_row "$r"
    flush
    nap 0.035
  done
  ROW_DX=0
}

reveal() { # row -- flip the tiles of a guess over, one by one
  local r=$1 c h=$((BT / 2))
  if ((!ANIM)); then draw_row "$r"; flush; return; fi
  REVEAL_ROW=$r
  for c in 0 1 2 3 4; do
    REVEAL_COL=$c
    if ((BT >= 3)); then
      if ((h / 2 > 0)); then draw_tile "$r" "$c" $((h / 2)); flush; nap 0.03; fi
      draw_tile "$r" "$c" "$h"; flush; nap 0.04
      REVEAL_COL=$((c + 1))
      if ((BT % 2)); then draw_tile "$r" "$c" "$h"; flush; nap 0.04; fi
      if ((h / 2 > 0)); then draw_tile "$r" "$c" $((h / 2)); flush; nap 0.03; fi
    fi
    REVEAL_COL=$((c + 1))
    draw_tile "$r" "$c"
    flush
    nap 0.06
  done
  REVEAL_ROW=-1
}

celebrate() { # row
  local c
  ((ANIM)) || return
  FLASH_ROW=$1
  for c in 0 1 2 3 4 5; do
    FLASH_COL=$c
    ((c < 5)) && draw_tile "$1" "$c"
    ((c > 0)) && { FLASH_COL=-1; draw_tile "$1" $((c - 1)); }
    flush
    nap 0.07
  done
  FLASH_ROW=-1 FLASH_COL=-1
}

# -------------------------------------------------------------- actions ----

type_letter() {
  [[ $STATE == playing ]] || return
  ((${#CUR} < 5)) || return
  clear_toast
  CUR+=$1
  draw_tile "${#GUESSES[@]}" $((${#CUR} - 1))
  flush
}

backspace() {
  [[ $STATE == playing && -n $CUR ]] || return
  clear_toast
  CUR=${CUR%?}
  draw_tile "${#GUESSES[@]}" "${#CUR}"
  flush
}

submit() {
  local g=$CUR r=${#GUESSES[@]}
  if [[ $STATE != playing ]]; then do_cmd stats; return; fi
  if ((${#g} < 5)); then toast "Not enough letters" error 2; shake; return; fi
  if ! is_word "$g"; then toast "Not in word list" error 2; shake; return; fi
  if ((GAME_HARD)) && ! hard_check "$g"; then toast "$REPLY" error 3; shake; return; fi
  clear_toast
  CUR=''
  add_guess "$g"
  save_game
  reveal "$r"
  draw_keyboard
  if [[ $STATE != playing ]]; then
    record_result
    [[ $STATE == won ]] && celebrate "$r"
    end_message
    draw_title
    draw_msg
    PENDING=stats
  fi
  flush
}

copy_result() {
  local text r i line sq_g='🟩' sq_y='🟨' sq_x='⬛' score=${#GUESSES[@]} tool
  [[ $THEME == contrast ]] && sq_g='🟧' sq_y='🟦'
  [[ $STATE == lost ]] && score=X
  if [[ $MODE == daily ]]; then text="Wordl #$((DAY - DAILY_BASE)) $score/6"; else text="Wordl practice $score/6"; fi
  ((GAME_HARD)) && text+='*'
  ((GAME_HARD > 1)) && text+='*'
  text+=$'\n'
  for ((r = 0; r < ${#MARKS[@]}; r++)); do
    line=''
    for i in 0 1 2 3 4; do
      case ${MARKS[r]:i:1} in g) line+=$sq_g ;; y) line+=$sq_y ;; *) line+=$sq_x ;; esac
    done
    text+=$'\n'$line
  done
  for tool in wl-copy pbcopy "xclip -selection clipboard" "xsel -ib" clip.exe; do
    if command -v "${tool%% *}" >/dev/null 2>&1; then
      printf '%s\n' "$text" | $tool >/dev/null 2>&1 && return 0
    fi
  done
  command -v base64 >/dev/null 2>&1 || return 1
  printf '\e]52;c;%s\a' "$(printf '%s\n' "$text" | base64 | tr -d '\n')"
}

do_cmd() {
  local i
  case $1 in
    help | stats) MODAL=$1 PENDING=''; render ;;
    close) MODAL=''; render ;;
    new)
      MODAL=''
      new_game practice
      render
      ;;
    daily) MODAL=''; new_game daily; render ;;
    theme)
      for i in "${!THEMES[@]}"; do [[ ${THEMES[i]} == "$THEME" ]] && break; done
      set_theme "${THEMES[(i + 1) % ${#THEMES[@]}]}"
      save_stats
      render
      [[ -z $MODAL && $STATE == playing && $LAYOUT != small ]] && toast "Theme: $THEME" plain 2
      ;;
    hard) # cycle the difficulty; a game under way can only get easier
      HARD=$(((HARD + 1) % 3))
      save_stats
      [[ $LAYOUT == small ]] && return
      if [[ $STATE == playing ]] && ((HARD <= GAME_HARD || ${#GUESSES[@]} == 0)); then
        GAME_HARD=$HARD
        save_game
        draw_title; draw_footer
        toast "Difficulty: ${DIFFS[HARD]}" plain 2
      else
        draw_footer
        [[ $STATE == playing ]] && toast "${DIFFS[HARD]} starts next game" plain 3
      fi
      flush
      ;;
    copy)
      [[ $STATE == playing ]] && return
      MODAL=''
      render
      if copy_result; then toast "Result copied" plain 0; else toast "No clipboard tool found" error 0; fi
      MSG_UNTIL=$((SECONDS + 3)) RESTORE_END=1
      ;;
    quit) exit 0 ;;
  esac
}

click() { # x y
  local h x1 y1 x2 y2 act
  local -a boxes=("${HITS[@]}")
  [[ -n $MODAL ]] && boxes=("${MHITS[@]}")
  for h in "${boxes[@]}"; do
    read -r x1 y1 x2 y2 act <<<"$h"
    if (($1 >= x1 && $1 <= x2 && $2 >= y1 && $2 <= y2)); then
      case $act in
        key:ENTER) submit ;;
        key:BACK) backspace ;;
        key:*) type_letter "${act#key:}" ;;
        cmd:*) do_cmd "${act#cmd:}" ;;
      esac
      return
    fi
  done
  [[ -n $MODAL ]] && do_cmd close
}

handle_key() {
  local k=$KEY
  [[ $k == ignore ]] && return
  PENDING=''
  case $k in
    $'\x11' | $'\x03') do_cmd quit ;;
    $'\x0c') get_size; layout; render; return ;;
    $'\x14') do_cmd theme; return ;;
    mouse) click "$MOUSE_X" "$MOUSE_Y"; return ;;
  esac
  if [[ $LAYOUT == small ]]; then return; fi
  if [[ -n $MODAL ]]; then
    case $MODAL:$k in
      stats:enter | stats:[nN]) if [[ $STATE == playing ]]; then do_cmd close; else do_cmd new; fi ;;
      stats:[cC]) if [[ $STATE == playing ]]; then do_cmd close; else do_cmd copy; fi ;;
      *) do_cmd close ;;
    esac
    return
  fi
  case $k in
    [a-zA-Z]) type_letter "${k^^}" ;;
    enter) submit ;;
    bksp) backspace ;;
    '?') do_cmd help ;;
    $'\x0e') do_cmd new ;;
    $'\x04') do_cmd daily ;;
    $'\x13') do_cmd stats ;;
    $'\x18') do_cmd hard ;;
  esac
}

# ---------------------------------------------------------------- input ----

read_key() { # timeout -> KEY; fails on timeout
  local c s rc
  KEY=''
  IFS= read -rsn1 -t "$1" c
  rc=$?
  ((rc > 128)) && return 1
  ((rc != 0)) && exit 0 # the terminal went away
  case $c in
    '' | $'\r') KEY=enter ;;
    $'\x7f' | $'\b') KEY=bksp ;;
    $'\e')
      if ! IFS= read -rsn1 -t 0.03 c; then KEY=esc; return 0; fi
      KEY=ignore
      if [[ $c == '[' ]]; then
        s=''
        while IFS= read -rsn1 -t 0.03 c; do
          s+=$c
          [[ $c == [a-zA-Z~] ]] && break
        done
        case $s in
          '<'*[Mm])
            local b x y
            IFS=';' read -r b x y <<<"${s:1:${#s}-2}"
            if [[ $s == *M && $b =~ ^[0-9]+$ && $x =~ ^[0-9]+$ && $y =~ ^[0-9]+$ ]] && ((b < 32 && (b & 3) == 0)); then
              KEY=mouse MOUSE_X=$x MOUSE_Y=$y
            fi
            ;;
          '3~') KEY=bksp ;;
        esac
      elif [[ $c == O ]]; then
        IFS= read -rsn1 -t 0.03 c
        [[ $c == P ]] && KEY='?' # F1
      fi
      ;;
    *) KEY=$c ;;
  esac
  return 0
}

# ----------------------------------------------------------------- main ----

usage() {
  cat <<EOF
wordl $VERSION - a Wordle-style word game for the terminal

Usage: wordl [options]

  -p, --practice     start with a new random word (default)
  -d, --daily        start with today's puzzle
  -t, --theme NAME   ${THEMES[*]}
      --normal       any dictionary word is a valid guess
      --hard         green letters stay fixed, yellow letters must be reused
      --ultra        ultra hard: also, yellow letters must move to another
                     spot and gray letters may not be played again
      --no-animation skip the tile animations
  -v, --version      print the version
  -h, --help         show this help

In the game: type letters, Enter to submit, Backspace to delete.
  ?  help        ^N new word             ^D daily puzzle    ^S statistics
  ^T theme       ^X difficulty           ^Q quit
The on-screen keyboard and the buttons can be clicked with the mouse.

Statistics are kept in ${XDG_STATE_HOME:-~/.local/state}/wordl.
EOF
}

cleanup() {
  printf '%s' "${CSI}?1006l${CSI}?1000l${CSI}?7h${CSI}0m${CSI}?25h${CSI}?1049l"
  [[ -n $STTY_SAVED ]] && stty "$STTY_SAVED" 2>/dev/null
}

main() {
  local self=${BASH_SOURCE[0]} dir opt_mode=practice opt_theme='' opt_hard='' timeout
  while [[ -L $self ]]; do
    dir=$(cd -P "$(dirname "$self")" && pwd)
    self=$(readlink "$self")
    [[ $self != /* ]] && self=$dir/$self
  done
  SELF_DIR=$(cd -P "$(dirname "$self")" && pwd)
  STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/wordl
  ANIM=1
  [[ -n ${WORDL_NO_ANIM:-} ]] && ANIM=0

  while (($#)); do
    case $1 in
      -d | --daily) opt_mode=daily ;;
      -p | --practice) opt_mode=practice ;;
      -t | --theme)
        shift
        if [[ " ${THEMES[*]} " != *" ${1:-} "* ]]; then
          echo "wordl: unknown theme '${1:-}' (choose from: ${THEMES[*]})" >&2
          exit 2
        fi
        opt_theme=$1
        ;;
      --hard) opt_hard=1 ;;
      --ultra) opt_hard=2 ;;
      --normal) opt_hard=0 ;;
      --no-animation) ANIM=0 ;;
      -v | --version) echo "wordl $VERSION"; exit 0 ;;
      -h | --help) usage; exit 0 ;;
      *) echo "wordl: unknown option '$1' (try --help)" >&2; exit 2 ;;
    esac
    shift
  done

  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "wordl: needs an interactive terminal." >&2
    exit 1
  fi
  if [[ ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} != *[Uu][Tt][Ff]* ]]; then
    export LC_ALL=C.UTF-8 # block characters and string lengths need UTF-8
  fi

  load_words
  load_kv "$STATE_DIR/stats" ST
  HARD=0
  [[ ${opt_hard:-${ST[hard]:-0}} == [12] ]] && HARD=${opt_hard:-${ST[hard]}}
  TRUECOLOR=0
  [[ ${COLORTERM:-} == truecolor || ${COLORTERM:-} == 24bit ]] && TRUECOLOR=1
  set_theme "${opt_theme:-${ST[theme]:-midnight}}"
  today
  ((${ST[daily_lastwin]:-0} < REPLY - 1)) && ST[daily_streak]=0

  NAP_FD=''
  exec {NAP_FD}<> <(:) 2>/dev/null || NAP_FD=''

  new_game "$opt_mode"

  STTY_SAVED=$(stty -g)
  trap cleanup EXIT
  trap 'exit 130' INT TERM HUP
  trap 'RESIZED=1' WINCH
  stty -echo -icanon -ixon min 1 time 0
  stty susp undef quit undef 2>/dev/null
  stty status undef 2>/dev/null # macOS: frees ^T
  printf '%s' "${CSI}?1049h${CSI}?25l${CSI}?7l${CSI}?1000h${CSI}?1006h"

  RESIZED=1 RESTORE_END=0
  while :; do
    if ((RESIZED)); then
      RESIZED=0
      get_size
      layout
      render
    fi
    timeout=1
    [[ -n $PENDING ]] && timeout=1.3
    if read_key "$timeout"; then
      handle_key
    elif [[ -n $PENDING && $LAYOUT != small ]]; then
      do_cmd "$PENDING"
    fi
    if [[ -n $MSG ]] && ((MSG_UNTIL && SECONDS >= MSG_UNTIL)); then
      MSG='' MSG_UNTIL=0
      # After "Result copied" the end-of-game message comes back.
      ((RESTORE_END)) && end_message
      RESTORE_END=0
      [[ $LAYOUT != small && -z $MODAL ]] && { draw_msg; flush; }
    fi
  done
}

# Sourcing the file (tests/run.sh does) defines everything without starting the game.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
