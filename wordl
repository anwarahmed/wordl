KB_ROWS=(QWERTYUIOP ASDFGHJKL ZXCVBNM)
DIFFS=(Normal Hard "Ultra Hard") # difficulty 0, 1, 2
LEVELS=(16 15 14 13 12 11 10 9 8 7 6 5 3 2 1)

